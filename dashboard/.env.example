# DevOps Dashboard Configuration
# Copy this file to .env and update the values

# Flask Configuration
DASHBOARD_SECRET_KEY=your-secret-key-here
DASHBOARD_DEBUG=True
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000

# Socket.IO Configuration
SOCKETIO_MESSAGE_QUEUE=redis://

# GitHub Integration
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_REPO=wwwphiokodotsolutions/LeChat-AI
GITHUB_POLL_INTERVAL=300

# Monitoring Configuration
MONITORING_INTERVAL=60
ALERT_THRESHOLD_CPU=80.0
ALERT_THRESHOLD_MEMORY=85.0
ALERT_THRESHOLD_DISK=90.0

# Docker Configuration
DOCKER_ENABLED=True
DOCKER_SOCKET=unix:///var/run/docker.sock

# Database Configuration
DATABASE_URL=sqlite:///dashboard.db

# Security Configuration
ALLOWED_ORIGINS=*

# Theme Configuration
DASHBOARD_TITLE=LeChat AI DevOps Dashboard
THEME_COLOR=#2563eb
